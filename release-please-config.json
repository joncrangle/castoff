{
	"packages": {
		".": {
			"release-type": "simple",
			"package-name": "castoff",
			"extra-files": [
				{ "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
				{ "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='castoff')].version" },
				{ "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='castoff-core')].version" }
			]
		}
	},
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
